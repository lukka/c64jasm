{
  "name": "c64jasm-devtools",
  "displayName": "c64jasm DevTools",
  "description": "DevTools for c64jasm offering debugging, project building, and code navigation.",
  "author": "Janne Hellsten",
  "contributors": [
    "Janne Hellsten",
    "Luca Cappa"
  ],
  "license": "MIT",
  "version": "0.11.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukka/c64jasm"
  },
  "publisher": "lukka",
  "icon": "media/icon.png",
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets"
  ],
  "keywords": [
    "c64",
    "assembler",
    "debug",
    "vice",
    "x64sc",
    "commodore 64",
    "c64jasm",
    "6510"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
    "onCommand:c64jasm-devtools.getProgramName"
  ],
  "main": "./client/out/extension",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "c64jasm tools configuration",
      "properties": {
        "c64jasm-devtools.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "c64jasm-devtools.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        },
        "c64jasm-devtools.vicePath": {
          "scope": "machine-overridable",
          "type": "string",
          "default": "x64sc",
          "description": "Where to find the VICE executable when starting a debug session"
        },
        "c64jasm-devtools.useEmbeddedCompiler": {
          "scope": "machine-overridable",
          "type": "boolean",
          "default": true,
          "description": "Use the embedded c64jasm compiler instead of the system-wide executable when debugging"
        },
        "c64jasm-devtools.disableCopilotIntegration": {
          "scope": "window",
          "type": "boolean",
          "default": false,
          "description": "Disable automatic C64 MCP server discovery in Copilot, the 'Update Copilot Assets' command, the post-update reminder, and deployment of Copilot assets into new projects. Explicit external MCP access is controlled separately. Asset changes take effect after reloading the window."
        },
        "c64jasm-devtools.enableMcp": {
          "scope": "window",
          "type": "boolean",
          "default": true,
          "description": "Enable the authenticated C64 MCP endpoint in trusted local workspaces. Disabling closes all MCP connections without stopping the debugger."
        },
        "c64jasm-devtools.allowExternalMcpClients": {
          "scope": "window",
          "type": "boolean",
          "default": false,
          "description": "Allow the Copy MCP Connection Details command to share this window's endpoint and bearer credential with external MCP clients. Credentials grant debugger access and expire on reload or MCP configuration changes."
        },
        "c64jasm-devtools.notifyToUpdateCopilotAssets": {
          "scope": "application",
          "type": "boolean",
          "default": true,
          "description": "After the c64jasm extension is updated to a new version, show a reminder to refresh the bundled Copilot assets (agents and skills) in your project via the 'c64jasm-devtools: Update Copilot Assets' command."
        }
      }
    },
    "languages": [
      {
        "id": "asm",
        "extensions": [
          ".asm",
          "jasm"
        ],
        "aliases": [
          "c64jasm",
          "asm",
          "jasm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "c64jasm",
        "owner": "c64jasm",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Compiling ",
          "endsPattern": "^Compilation (succeeded|failed)"
        }
      }
    ],
    "grammars": [
      {
        "language": "asm",
        "scopeName": "source.asm.c64",
        "path": "./syntaxes/c64jasm.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "asm"
      }
    ],
    "debuggers": [
      {
        "type": "c64jasm-debug",
        "label": "c64jasm Debug",
        "program": "./client/out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "source": {
                "type": "string",
                "description": "Absolute path to the source file to compile."
              },
              "disasm": {
                "type": "string",
                "description": "Absolute path to the disasm file."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": false
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "c64jasm-debug",
            "request": "launch",
            "name": "Ask for file name",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "c64jasm Debug: Launch",
            "description": "A new configuration for 'debugging' a user selected markdown file.",
            "body": {
              "type": "c64jasm-debug",
              "request": "launch",
              "name": "Ask for file name",
              "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
              "stopOnEntry": false
            }
          }
        ],
        "variables": {
          "AskForProgramName": "c64jasm-devtools.getProgramName"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "c64jasm",
        "label": "c64jasm"
      }
    ],
    "commands": [
      {
        "command": "c64jasm-devtools.copyMcpConnection",
        "title": "Copy MCP Connection Details",
        "category": "c64jasm-devtools"
      },
      {
        "command": "c64jasm-devtools.showC64Runtime",
        "title": "Show C64 Runtime",
        "category": "c64jasm-devtools"
      },
      {
        "command": "c64jasm-devtools.createProject",
        "title": "Create New Project",
        "category": "c64jasm-devtools"
      },
      {
        "command": "c64jasm-devtools.updateCopilotAssets",
        "title": "Update Copilot Assets",
        "category": "c64jasm-devtools"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "c64jasm-devtools.updateCopilotAssets",
          "when": "!config.c64jasm-devtools.disableCopilotIntegration && c64jasm:hasProject"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "cross-env NODE_ENV=production npm run compile",
    "compile:client": "tsc -noEmit -p ./client/tsconfig.json",
    "compile:server": "tsc -noEmit -p ./server/tsconfig.json",
    "compile:mcp": "npm --prefix mcp run typecheck && npm --prefix mcp run build",
    "build:esbuild": "node esbuild.js",
    "precompile:vue": "npm run lint:vue:fix",
    "compile:vue": "cd client/web && vue-cli-service build --mode production --dest ../out/media/page1",
    "watch:client": "tsc -w -noEmit -p ./client/tsconfig.json",
    "watch:server": "tsc -w -noEmit -p ./server/tsconfig.json",
    "compile": "npm run compile:client && npm run compile:server && npm run build:esbuild && npm run compile:vue",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "sh ./scripts/e2e.sh",
    "test:mcp": "npm --prefix mcp test",
    "serve:vue": "cd client/web && vue-cli-service serve",
    "build:vue": "cd client/web && vue-cli-service build --mode development --dest ../out/media/page1",
    "build:vue:prod": "cd client/web && vue-cli-service build --mode production --dest ../out/media/page1",
    "lint:vue": "cd client/web && vue-cli-service lint",
    "lint:vue:fix": "cd client/web && vue-cli-service lint --fix",
    "package": "shx mkdir -p build && vsce package --out build/",
    "test:mcp:vscode": "npm run compile:mcp && node --test mcp/test/vscode.e2e.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@types/mocha": "^5.2.0",
    "@types/node": "^20.19.41",
    "@vscode/vsce": "^3.6.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "^5.0.1",
    "@vue/eslint-config-typescript": "^13.0.0",
    "c64jasm": "file:./vendor/c64jasm.tgz",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "get-port": "^7.2.0",
    "is-running": "^2.1.0",
    "lodash": "^4.18.1",
    "prettier": "^2.4.1",
    "shx": "^0.3.4",
    "tree-kill": "^1.2.2",
    "typescript": "^5.3.3",
    "typescript-strict-plugin": "^2.2.0",
    "vscode-debugadapter": "^1.51.0",
    "vscode-debugprotocol": "^1.51.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0",
    "vue": "^3.2.31",
    "vue-template-compiler": "^2.6.14",
    "vuex": "^4.0.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
